{
  "name": "@tillflow/payments",
  "version": "0.1.0",
  "private": true,
  "description": "TillFlow Payments API \u2014 Daraja STK/B2C, payment state machine, callbacks, payouts.",
  "main": "server.js",
  "scripts": {
    "start": "node --require ./otel-bootstrap.js server.js",
    "migrate": "node bin/migrate.js up",
    "migrate:down": "node bin/migrate.js down",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint .",
    "test:contract": "node --test --test-concurrency=1 test/*.contract.js",
    "evidence:g2": "node scripts/g2-happy-path.js",
    "evidence:timeout": "node scripts/g2-timeout.js",
    "evidence:close": "node scripts/g2-close-b2c.js",
    "daraja:contract": "node scripts/daraja-contract.js",
    "g4:drills": "node scripts/g4-payment-drills.js"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "express": "^4.21.2",
    "node-pg-migrate": "^7.8.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-xray": "^3.1136.0",
    "eslint": "^9.15.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "glob": "^11.1.0"
  }
}
